# NOVA Runtime Environment Variables (Layer 3 of Config Hierarchy: defaults -> file -> env -> runtime)
NOVA_ENVIRONMENT=development
NOVA_LOG_LEVEL=INFO

# ADR-001: Offline-First & Privacy Floor
NOVA_OFFLINE_BY_DEFAULT=true
NOVA_ALLOW_CLOUD_INFERENCE=false
NOVA_ALLOW_CLOUD_SENSITIVE_DATA=false
NOVA_TELEMETRY_ENABLED=false

# ADR-010: Security-First Permission Model
NOVA_FAIL_CLOSED_PERMISSIONS=true
NOVA_DEFAULT_SENSITIVE_ACTION_POLICY=ask_every_time

# ADR-003 & ADR-004: Execution Bounds
NOVA_MAX_GRAPH_STEPS=25
NOVA_MAX_REACT_ITERATIONS_PER_NODE=5
NOVA_MAX_RETRIES_PER_NODE=3

# NFR Resource, Audit & Concurrency Targets
NOVA_MAX_IDLE_MEMORY_MB=500
NOVA_AUDIT_LOG_RETENTION_DAYS=30
NOVA_MAX_CONCURRENT_AGENTS=4

# Local Serving & Storage Defaults
NOVA_LOCAL_MODEL_PROVIDER=llamacpp
NOVA_DEFAULT_LOCAL_MODEL_ID=qwen2.5-7b-instruct-q4_k_m.gguf
NOVA_VECTOR_DB_PROVIDER=lancedb